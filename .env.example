# Copy this file to ".env" and fill in your values.

# Camera: RTSP URL of an IP camera (recommended with Docker),
# or a device index like 0 (Linux host with --device only).
CAMERA_SOURCE=rtsp://user:password@192.168.1.50:554/stream1

# Minutes on the floor before the alert is sent
ALERT_MINUTES=15

# Telegram bot for the responsible person (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
